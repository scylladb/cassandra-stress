{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "commitBodyTable": true,
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "enabledManagers": [
    "maven",
    "dockerfile",
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "maven",
      "managerFilePatterns": [
        "/(^|/)build\\.xml$/"
      ],
      "depNameTemplate": "com.scylladb:scylla-driver-core",
      "matchStrings": [
        "<property name=\"base.javaDriverVersion\" value=\"(?<currentValue>[\\w+\\.\\-]*)\""
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "maven",
      "managerFilePatterns": [
        "/(^|/)build\\.xml$/"
      ],
      "depNameTemplate": "com.scylladb:java-driver-core-shaded",
      "matchStrings": [
        "<property name=\"base.java4DriverVersion\" value=\"(?<currentValue>[\\w+\\.\\-]*)\""
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "maven",
      "managerFilePatterns": [
        "/(^|/)build\\.xml$/"
      ],
      "depNameTemplate": "{{{groupId}}}:{{{artifactId}}}",
      "matchStrings": [
        "<dependency groupId=\"(?<groupId>[^\"]+)\" artifactId=\"(?<artifactId>[^\"]+)\"\\s+version=\"(?<currentValue>[^\"$]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.scylladb:java-driver-core-shaded"
      ],
      "groupName": "scylla java driver"
    },
    {
      "matchPackageNames": [
        "/^com\\.fasterxml\\.jackson\\.core:/"
      ],
      "groupName": "jackson"
    },
    {
      "matchPackageNames": [
        "/^org\\.slf4j:/",
        "/^ch\\.qos\\.logback:/"
      ],
      "groupName": "logging"
    }
  ]
}
