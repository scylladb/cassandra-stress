{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "commitBodyTable": true,
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.scylladb:java-driver-core-shaded"
      ],
      "groupName": "scylla java driver"
    },
    {
      "matchPackageNames": [
        "/^com\\.fasterxml\\.jackson\\.core:/"
      ],
      "groupName": "jackson"
    },
    {
      "matchPackageNames": [
        "/^org\\.slf4j:/",
        "/^ch\\.qos\\.logback:/"
      ],
      "groupName": "logging"
    }
  ]
}
