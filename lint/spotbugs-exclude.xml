<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- The text blocks of the integration tests are YAML profiles, which need \n on every platform. -->
    <Match>
        <Source name="~.*IT\.java" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW,EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,PA_PUBLIC_PRIMITIVE_ATTRIBUTE,DM_EXIT,HSM_HIDING_METHOD,REC_CATCH_EXCEPTION" />
    </Match>
    <Match>
        <Class name="org.apache.cassandra.stress.StressYaml$QueryDef" />
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD" />
    </Match>
    <Match>
        <Class name="org.apache.cassandra.stress.StressYaml$TokenRangeQueryDef" />
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD" />
    </Match>
    <Match>
        <Class name="org.apache.cassandra.stress.marshal.BooleanSerializer" />
        <Bug pattern="NP_BOOLEAN_RETURN_NULL" />
    </Match>
    <Match>
        <Or>
            <Class name="org.apache.cassandra.stress.util.MurmurHash" />
            <And>
                <Class name="org.apache.cassandra.stress.settings.OptionDistribution" />
                <Method name="parseLong" />
            </And>
        </Or>
        <Bug pattern="SF_SWITCH_FALLTHROUGH,SF_SWITCH_NO_DEFAULT" />
    </Match>
    <Match>
        <Class name="org.apache.cassandra.stress.StressAction" />
        <Method name="run" />
        <Bug code="RV" />
    </Match>
    <Match>
        <Class name="org.apache.cassandra.stress.settings.OptionEnumProbabilities$OptMatcher" />
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS" />
    </Match>
    <!-- The driver modules read these fields. SpotBugs analyzes each module alone and does not see them. -->
    <Match>
        <Class name="org.apache.cassandra.stress.util.EncryptionOptions" />
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD" />
    </Match>
    <!-- The heap balancer collects so that ZGC returns the heap above a lower soft maximum heap. -->
    <Match>
        <Class name="org.apache.cassandra.stress.HeapBalancer" />
        <Method name="balance" />
        <Bug pattern="DM_GC" />
    </Match>
    <!-- The Random of nextGaussian stays in a field and gives the gaussians until the next rollover. -->
    <Match>
        <Class name="org.apache.cassandra.stress.generate.FasterRandom" />
        <Method name="nextGaussian" />
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE" />
    </Match>
    <!-- The heap balancer reads the memory of the process from the fixed paths of /proc and /sys on Linux. -->
    <Match>
        <Class name="org.apache.cassandra.stress.HeapBalancer$SystemMemory" />
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME" />
    </Match>
</FindBugsFilter>
