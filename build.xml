<project basedir="." default="jar" name="cassandra-stress"
    xmlns:resolver="antlib:org.apache.maven.resolver.ant"
    xmlns:jacoco="antlib:org.jacoco.ant">

    <fail message="You need to use Ant of version at least 1.10 to continue.">
        <condition>
            <not>
                <antversion atleast="1.10" />
            </not>
        </condition>
    </fail>

    <property environment="env" />
    <property file="build.properties" />
    <property file="build.properties.default" />
    <property name="debuglevel" value="source,lines,vars" />

    <property name="base.version" value="3.12.0" />
    <property name="base.javaDriverVersion" value="3.11.5.19" />
    <property name="base.java4DriverVersion" value="4.19.2.2" />

    <property name="basedir" value="." />
    <property name="build.src" value="${basedir}/src" />
    <property name="build.src.java" value="${basedir}/src/java" />
    <property name="build.src.resources" value="${basedir}/src/resources" />
    <property name="build.lib" value="${basedir}/lib" />
    <property name="build.dir" value="${basedir}/build" />
    <property name="build.dir.lib" value="${basedir}/build/lib" />
    <property name="build.test.dir" value="${build.dir}/test" />
    <property name="build.classes" value="${build.dir}/classes" />
    <property name="build.classes.main" value="${build.classes}/main" />
    <property name="test.dir" value="${basedir}/test" />
    <property name="test.resources" value="${test.dir}/resources" />
    <property name="test.lib" value="${build.dir}/test/lib" />
    <property name="test.classes" value="${build.dir}/test/classes" />
    <property name="test.name" value="*Test" />
    <property name="test.unit.src" value="${test.dir}/unit" />
    <property name="test.integration.src" value="${test.dir}/integration" />
    <property name="test.integration.classes" value="${build.dir}/test/integration-classes" />
    <property name="test.integration.lib" value="${build.dir}/test/integration-lib" />
    <property name="test.integration.name" value="*IT" />
    <property name="test.integration.timeout" value="1800000" />
    <property name="testcontainers.version" value="2.0.5" />
    <property name="test.jvmargs" value="" />
    <property name="errorprone.version" value="2.50.0" />
    <property name="checkstyle.version" value="14.3.0" />
    <property name="pmd.version" value="7.28.0" />
    <property name="spotbugs.version" value="4.10.4" />
    <property name="palantir.version" value="2.102.0" />
    <property name="lint.dir" value="${build.dir}/lint" />
    <property name="lint.config" value="${basedir}/lint" />
    <property name="test.timeout" value="240000" />
    <property name="junit.version" value="6.1.3" />
    <property name="jacoco.version" value="0.8.15" />
    <property name="coverage.dir" value="${build.dir}/coverage" />
    <property name="dist.dir" value="${build.dir}/dist" />
    <property name="tmp.dir" value="${java.io.tmpdir}" />

    <property name="release.version" value="21" />

    <condition property="version" value="${base.version}">
        <isset property="release" />
    </condition>
    <property name="version" value="${base.version}-SNAPSHOT" />
    <property name="final.name" value="${ant.project.name}" />

    <property name="local.repository" value="${user.home}/.m2/repository" />

    <condition property="is.source.artifact">
        <available file="${build.src.java}" type="dir" />
    </condition>

    <path id="cassandra-stress.classpath">
        <pathelement location="${build.classes.main}" />
        <fileset dir="${build.dir.lib}">
            <include name="**/*.jar" />
        </fileset>
    </path>
    <path id="cassandra-stress.classpath.test">
        <fileset dir="${build.dir.lib}">
            <include name="**/*.jar" />
            <exclude name="**/*-sources.jar" />
            <exclude name="cassandra-stress.jar" />
        </fileset>
        <fileset dir="${test.lib}/jars">
            <include name="**/*.jar" />
        </fileset>
    </path>

    <property name="resolver-ant-tasks.version" value="1.3.0" />
    <property name="resolver-ant-tasks.local"
        value="${local.repository}/org/apache/maven/resolver/maven-resolver-ant-tasks/${resolver-ant-tasks.version}/maven-resolver-ant-tasks-${resolver-ant-tasks.version}.jar" />
    <property name="resolver-ant-tasks.url"
        value="https://repo1.maven.org/maven2/org/apache/maven/resolver/maven-resolver-ant-tasks" />

    <condition property="resolver-ant-tasks.jar.exists">
        <available file="${resolver-ant-tasks.local}" />
    </condition>

    <path id="resolver-ant-tasks.classpath" path="${resolver-ant-tasks.local}" />

    <target name="_resolver_download" unless="resolver-ant-tasks.jar.exists"
        description="Fetch Resolver ANT Tasks from Maven Central Repository">
        <echo>Downloading Resolver ANT Tasks...</echo>
        <mkdir
            dir="${local.repository}/org/apache/maven/resolver/maven-resolver-ant-tasks/${resolver-ant-tasks.version}" />
        <get
            src="${resolver-ant-tasks.url}/${resolver-ant-tasks.version}/maven-resolver-ant-tasks-${resolver-ant-tasks.version}-uber.jar"
            dest="${resolver-ant-tasks.local}" usetimestamp="true" quiet="true" />
    </target>

    <target name="resolver-init" depends="init,_resolver_download"
        unless="resolver-ant-tasks.initialized"
        description="Initialize Resolver ANT Tasks and declare the dependencies">
        <typedef uri="antlib:org.apache.maven.resolver.ant"
            resource="org/apache/maven/resolver/ant/antlib.xml"
            classpathref="resolver-ant-tasks.classpath" />
        <resolver:remoterepos id="all">
            <remoterepo id="resolver-central" url="${artifact.remoteRepository.central}" />
            <remoterepo id="resolver-apache" url="${artifact.remoteRepository.apache}" />
        </resolver:remoterepos>

        <resolver:dependencies id="runtime-deps">
            <dependency groupId="com.scylladb" artifactId="scylla-driver-core"
                version="${base.javaDriverVersion}" classifier="shaded">
                <exclusion groupId="io.netty" artifactId="*" />
                <exclusion groupId="org.slf4j" artifactId="slf4j-api" />
                <exclusion groupId="com.github.jnr" artifactId="*" />
                <exclusion groupId="io.dropwizard.metrics" artifactId="metrics-core" />
                <exclusion groupId="com.google.guava" artifactId="listenablefuture" />
                <exclusion groupId="com.google.j2objc" artifactId="j2objc-annotations" />
                <exclusion groupId="com.google.code.findbugs" artifactId="jsr305" />
                <exclusion groupId="com.google.errorprone" artifactId="error_prone_annotations" />
                <exclusion groupId="org.checkerframework" artifactId="checker-qual" />
            </dependency>
            <dependency groupId="com.scylladb" artifactId="java-driver-core-shaded"
                version="${base.java4DriverVersion}">
                <exclusion groupId="com.typesafe" artifactId="config" />
                <exclusion groupId="org.slf4j" artifactId="slf4j-api" />
                <exclusion groupId="io.dropwizard.metrics" artifactId="metrics-core" />
                <exclusion groupId="org.hdrhistogram" artifactId="HdrHistogram" />
                <exclusion groupId="com.github.jnr" artifactId="jnr-posix" />
                <exclusion groupId="org.reactivestreams" artifactId="reactive-streams" />
            </dependency>
            <dependency groupId="org.apache.commons" artifactId="commons-math3" version="3.6.1" />
            <dependency groupId="org.yaml" artifactId="snakeyaml" version="2.7" />
            <dependency groupId="com.fasterxml.jackson.core" artifactId="jackson-core" version="2.22.3" />
            <dependency groupId="com.fasterxml.jackson.core" artifactId="jackson-databind" version="2.22.3" />
            <dependency groupId="org.jctools" artifactId="jctools-core" version="4.0.7" />
            <dependency groupId="org.hdrhistogram" artifactId="HdrHistogram" version="2.2.2" />
            <dependency groupId="com.typesafe" artifactId="config" version="1.4.9" />
            <dependency groupId="org.slf4j" artifactId="slf4j-api" version="2.0.19" />
            <dependency groupId="ch.qos.logback" artifactId="logback-classic" version="1.6.5" />
            <dependency groupId="at.yawk.lz4" artifactId="lz4-java" version="1.12.0" />
            <dependency groupId="org.xerial.snappy" artifactId="snappy-java" version="1.1.10.10" />
        </resolver:dependencies>

        <resolver:dependencies id="test-deps">
            <dependency groupId="org.junit.jupiter" artifactId="junit-jupiter" version="${junit.version}" scope="test" />
            <dependency groupId="org.junit.platform" artifactId="junit-platform-launcher" version="${junit.version}" scope="test" />
            <dependency groupId="org.reactivestreams" artifactId="reactive-streams" version="1.0.4" scope="test" />
        </resolver:dependencies>

        <resolver:dependencies id="integration-deps">
            <dependency groupId="org.testcontainers" artifactId="testcontainers-scylladb" version="${testcontainers.version}">
                <exclusion groupId="junit" artifactId="junit" />
            </dependency>
        </resolver:dependencies>

        <resolver:dependencies id="errorprone-deps">
            <dependency groupId="com.google.errorprone" artifactId="error_prone_core" version="${errorprone.version}" />
        </resolver:dependencies>

        <resolver:dependencies id="checkstyle-deps">
            <dependency groupId="com.puppycrawl.tools" artifactId="checkstyle" version="${checkstyle.version}" />
        </resolver:dependencies>

        <resolver:dependencies id="pmd-deps">
            <dependency groupId="net.sourceforge.pmd" artifactId="pmd-ant" version="${pmd.version}" />
            <dependency groupId="net.sourceforge.pmd" artifactId="pmd-java" version="${pmd.version}" />
        </resolver:dependencies>

        <resolver:dependencies id="spotbugs-deps">
            <dependency groupId="com.github.spotbugs" artifactId="spotbugs-ant" version="${spotbugs.version}" />
            <dependency groupId="com.github.spotbugs" artifactId="spotbugs" version="${spotbugs.version}" />
        </resolver:dependencies>

        <resolver:dependencies id="format-deps">
            <dependency groupId="com.palantir.javaformat" artifactId="palantir-java-format" version="${palantir.version}" />
        </resolver:dependencies>

        <resolver:dependencies id="coverage-deps">
            <dependency groupId="org.jacoco" artifactId="org.jacoco.ant" version="${jacoco.version}" classifier="nodeps" />
        </resolver:dependencies>

        <property name="resolver-ant-tasks.initialized" value="true" />
    </target>

    <target name="resolver-retrieve-build" depends="resolver-init">
        <resolver:resolve>
            <remoterepos refid="all" />
            <dependencies refid="runtime-deps" />
            <files dir="${build.dir.lib}/jars"
                layout="{artifactId}-{version}-{classifier}.{extension}"
                scopes="compile,runtime,!system" />
        </resolver:resolve>
        <resolver:resolve>
            <remoterepos refid="all" />
            <dependencies refid="test-deps" />
            <files dir="${test.lib}/jars" layout="{artifactId}-{version}-{classifier}.{extension}"
                scopes="test,!system" />
        </resolver:resolve>
    </target>

    <target name="init">
        <fail unless="is.source.artifact"
            message="Not a source artifact, stopping here." />
        <mkdir dir="${build.classes.main}" />
        <mkdir dir="${test.lib}" />
        <mkdir dir="${test.lib}/jars" />
        <mkdir dir="${test.classes}" />
        <mkdir dir="${build.dir.lib}" />
    </target>

    <target name="clean" description="Remove all locally created artifacts">
        <delete dir="${build.test.dir}" />
        <delete dir="${build.classes}" />
    </target>

    <target name="realclean" depends="clean"
        description="Remove the entire build directory and all downloaded artifacts">
        <delete dir="${build.lib}" />
        <delete dir="${build.dir}" />
    </target>

    <target name="build" depends="resolver-retrieve-build,build-project"
        description="Compile cassandra-stress classes" />

    <target name="build_java">
        <javac fork="true"
            compiler="modern"
            debug="true"
            debuglevel="${debuglevel}"
            encoding="utf-8"
            destdir="${build.classes.main}"
            includeantruntime="false"
            release="${release.version}"
            memorymaximumsize="512M">
            <src path="${build.src.java}" />
            <compilerarg value="-proc:none" />
            <classpath>
                <path refid="cassandra-stress.classpath" />
            </classpath>
        </javac>
    </target>

    <target depends="init" name="build-project">
        <echo message="${ant.project.name}: ${ant.file}" />
        <antcall target="build_java" />
        <copy todir="${build.classes.main}">
            <fileset dir="${build.src.resources}" />
        </copy>
        <echo file="${build.classes.main}/org/apache/cassandra/stress/stress.version" message="${version}" />
    </target>

    <target name="jar" depends="build" description="Assemble the cassandra-stress JAR file">
        <mkdir dir="${build.dir}/lib/" />
        <jar destfile="${build.dir}/lib/cassandra-stress.jar">
            <fileset dir="${build.classes.main}" />
            <manifest>
                <attribute name="Implementation-Version" value="${version}" />
            </manifest>
        </jar>
    </target>

    <target name="artifacts" depends="jar"
        description="Create cassandra-stress release artifacts">
        <delete dir="${dist.dir}" />
        <mkdir dir="${dist.dir}" />
        <fixcrlf srcdir="conf" includes="**/*" eol="lf" eof="remove" />
        <fixcrlf srcdir="bin" includes="**/*" eol="lf" eof="remove" />
        <copy todir="${dist.dir}/lib">
            <fileset dir="${build.dir.lib}/jars" />
            <fileset dir="${build.dir.lib}">
                <include name="cassandra-stress.jar" />
            </fileset>
        </copy>

        <copy todir="${dist.dir}/conf">
            <fileset dir="conf" />
        </copy>

        <copy todir="${dist.dir}/bin">
            <fileset dir="bin" />
        </copy>

        <copy todir="${dist.dir}/">
            <fileset dir="${basedir}">
                <include name="*.txt" />
            </fileset>
        </copy>

        <copy todir="${dist.dir}/examples/">
            <fileset dir="${basedir}/examples/">
                <include name="*.yaml" />
            </fileset>
        </copy>

        <tar compression="gzip" longfile="gnu"
            destfile="${build.dir}/cassandra-stress-bin.tar.gz">
            <tarfileset dir="${dist.dir}" prefix="cassandra-stress">
                <include name="**" />
                <exclude name="bin/*" />
            </tarfileset>
            <tarfileset dir="${dist.dir}" prefix="cassandra-stress" mode="755">
                <include name="bin/*" />
                <exclude name="bin/*.in.sh" />
            </tarfileset>
        </tar>

        <tar compression="gzip" longfile="gnu"
            destfile="${build.dir}/cassandra-stress-src.tar.gz">
            <tarfileset dir="${basedir}"
                prefix="cassandra-stress-src">
                <include name="**" />
                <exclude name="build/**" />
                <exclude name="lib/**" />
                <exclude name=".git/**" />
                <exclude name="venv/**" />
                <exclude name="bin/*" />
                <exclude name="**/__pycache__/**" />
                <exclude name=".project" />
                <exclude name=".classpath" />
                <exclude name=".settings/**" />
                <exclude name=".externalToolBuilders/**" />
                <exclude name="ide/nbproject/private/**" />
                <exclude name="Dockerfile" />
                <exclude name=".dockerignore" />
                <exclude name=".claude/**" />
                <exclude name="CLAUDE.md" />
                <exclude name="tasks/**" />
                <exclude name="docs/standards/**" />
                <exclude name="docs/INDEX.md" />
            </tarfileset>
            <tarfileset dir="${basedir}" prefix="cassandra-stress-src" mode="755">
                <include name="tools/bin/*" />
            </tarfileset>
        </tar>

        <checksum forceOverwrite="yes" todir="${build.dir}" fileext=".sha256" algorithm="SHA-256">
            <fileset dir="${build.dir}">
                <include name="cassandra-stress-bin.tar.gz" />
                <include name="cassandra-stress-src.tar.gz" />
            </fileset>
        </checksum>
        <checksum forceOverwrite="yes" todir="${build.dir}" fileext=".sha512" algorithm="SHA-512">
            <fileset dir="${build.dir}">
                <include name="cassandra-stress-bin.tar.gz" />
                <include name="cassandra-stress-src.tar.gz" />
            </fileset>
        </checksum>
    </target>

    <target name="build-test" depends="build"
        description="Compile test classes" unless="no-build-test">
        <javac
            compiler="modern"
            debug="true"
            debuglevel="${debuglevel}"
            destdir="${test.classes}"
            includeantruntime="false"
            release="${release.version}"
            encoding="utf-8">
            <compilerarg value="-proc:none" />
            <classpath>
                <path refid="cassandra-stress.classpath.test" />
                <path refid="cassandra-stress.classpath" />
            </classpath>
            <src path="${test.unit.src}" />
        </javac>
        <copy todir="${test.classes}">
            <fileset dir="${test.resources}" />
        </copy>
    </target>

    <macrodef name="run-unit-tests">
        <attribute name="jvmargs" default="" />
        <attribute name="classes" default="${test.classes}" />
        <attribute name="includes" default="**/${test.name}.class" />
        <attribute name="output" default="${build.test.dir}/output" />
        <attribute name="timeout" default="${test.timeout}" />
        <element name="extra-classpath" optional="true" />
        <sequential>
            <delete dir="@{output}" />
            <mkdir dir="@{output}" />
            <junitlauncher failureProperty="testfailed" printSummary="true">
                <classpath>
                    <path refid="cassandra-stress.classpath" />
                    <path refid="cassandra-stress.classpath.test" />
                    <pathelement location="${test.classes}" />
                    <extra-classpath />
                </classpath>
                <testclasses outputDir="@{output}">
                    <fileset dir="@{classes}" includes="@{includes}" />
                    <fork dir="${basedir}" timeout="@{timeout}">
                        <jvmarg value="-ea" />
                        <jvmarg value="-Xmx1024m" />
                        <jvmarg value="-Djava.io.tmpdir=${tmp.dir}" />
                        <jvmarg value="-Dcom.datastax.oss.driver.shaded.netty.noUnsafe=true" />
                        <jvmarg value="-Dcom.datastax.shaded.netty.noUnsafe=true" />
                        <jvmarg line="${test.jvmargs}" />
                        <jvmarg line="@{jvmargs}" />
                    </fork>
                    <listener type="legacy-xml" sendSysOut="true" sendSysErr="true" />
                    <listener type="legacy-brief" sendSysOut="false" />
                </testclasses>
            </junitlauncher>
        </sequential>
    </macrodef>

    <target name="test" depends="build-test" description="Run the unit tests, or one class with -Dtest.name=ClassNameTest">
        <run-unit-tests />
        <fail message="Some test(s) failed." if="testfailed" />
    </target>

    <target name="integration-init" depends="resolver-init">
        <resolver:resolve>
            <remoterepos refid="all" />
            <dependencies refid="integration-deps" />
            <files dir="${test.integration.lib}" layout="{artifactId}-{version}-{classifier}.{extension}" scopes="compile,runtime,!system" />
        </resolver:resolve>
    </target>

    <target name="build-integration-test" depends="build-test,integration-init"
        description="Compile the integration tests">
        <mkdir dir="${test.integration.classes}" />
        <javac
            compiler="modern"
            debug="true"
            debuglevel="${debuglevel}"
            destdir="${test.integration.classes}"
            includeantruntime="false"
            release="${release.version}"
            encoding="utf-8">
            <compilerarg value="-proc:none" />
            <classpath>
                <path refid="cassandra-stress.classpath.test" />
                <path refid="cassandra-stress.classpath" />
                <pathelement location="${test.classes}" />
                <fileset dir="${test.integration.lib}" includes="*.jar" />
            </classpath>
            <src path="${test.integration.src}" />
        </javac>
    </target>

    <macrodef name="run-integration-tests">
        <attribute name="jvmargs" default="" />
        <attribute name="driver" />
        <sequential>
            <run-unit-tests jvmargs="@{jvmargs} -Dstress.it.driver=@{driver}" classes="${test.integration.classes}"
                includes="**/${test.integration.name}.class" output="${build.test.dir}/integration-output-@{driver}"
                timeout="${test.integration.timeout}">
                <extra-classpath>
                    <pathelement location="${test.integration.classes}" />
                    <fileset dir="${test.integration.lib}" includes="*.jar" />
                </extra-classpath>
            </run-unit-tests>
        </sequential>
    </macrodef>

    <target name="integration-test" depends="build-integration-test"
        description="Run the integration tests against ScyllaDB in Docker, or one class with -Dtest.integration.name=ClassNameIT">
        <run-integration-tests driver="native" />
        <run-integration-tests driver="4x" />
        <fail message="Some integration test(s) failed." if="testfailed" />
    </target>

    <target name="coverage-init" depends="resolver-init">
        <resolver:resolve>
            <remoterepos refid="all" />
            <dependencies refid="coverage-deps" />
            <files dir="${build.dir}/jacoco" layout="{artifactId}-{classifier}.{extension}" scopes="compile,runtime,!system" />
        </resolver:resolve>
        <taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml"
            classpath="${build.dir}/jacoco/org.jacoco.ant-nodeps.jar" />
    </target>

    <macrodef name="coverage-report">
        <sequential>
            <jacoco:report>
                <executiondata>
                    <file file="${coverage.dir}/jacoco.exec" />
                </executiondata>
                <structure name="cassandra-stress">
                    <classfiles>
                        <fileset dir="${build.classes.main}" includes="**/*.class" />
                    </classfiles>
                    <sourcefiles encoding="UTF-8">
                        <fileset dir="${build.src.java}" />
                    </sourcefiles>
                </structure>
                <html destdir="${coverage.dir}/html" />
                <xml destfile="${coverage.dir}/jacoco.xml" />
                <csv destfile="${coverage.dir}/jacoco.csv" />
            </jacoco:report>
        </sequential>
    </macrodef>

    <target name="coverage" depends="build-test,coverage-init"
        description="Run the unit tests with JaCoCo and write the report to build/coverage">
        <delete dir="${coverage.dir}" />
        <mkdir dir="${coverage.dir}" />
        <jacoco:agent property="test.coverage.agent" destfile="${coverage.dir}/jacoco.exec"
            includes="org.apache.cassandra.stress.*" />
        <run-unit-tests jvmargs="${test.coverage.agent}" />
        <coverage-report />
        <fail message="Some test(s) failed." if="testfailed" />
    </target>

    <target name="coverage-all" depends="build-integration-test,coverage-init"
        description="Run the unit and integration tests with JaCoCo and write one report to build/coverage">
        <delete dir="${coverage.dir}" />
        <mkdir dir="${coverage.dir}" />
        <jacoco:agent property="test.coverage.agent" destfile="${coverage.dir}/jacoco.exec"
            includes="org.apache.cassandra.stress.*" append="true" />
        <run-unit-tests jvmargs="${test.coverage.agent}" />
        <run-integration-tests jvmargs="${test.coverage.agent}" driver="native" />
        <run-integration-tests jvmargs="${test.coverage.agent}" driver="4x" />
        <coverage-report />
        <fail message="Some test(s) failed." if="testfailed" />
    </target>
    <macrodef name="resolve-tool">
        <attribute name="deps" />
        <attribute name="dir" />
        <sequential>
            <resolver:resolve>
                <remoterepos refid="all" />
                <dependencies refid="@{deps}" />
                <files dir="@{dir}" layout="{artifactId}-{version}-{classifier}.{extension}" scopes="compile,runtime,!system" />
            </resolver:resolve>
        </sequential>
    </macrodef>

    <target name="lint-init" depends="resolver-init">
        <resolve-tool deps="errorprone-deps" dir="${lint.dir}/lib/errorprone" />
        <resolve-tool deps="checkstyle-deps" dir="${lint.dir}/lib/checkstyle" />
        <resolve-tool deps="pmd-deps" dir="${lint.dir}/lib/pmd" />
        <resolve-tool deps="spotbugs-deps" dir="${lint.dir}/lib/spotbugs" />
        <mkdir dir="${lint.dir}/reports" />
    </target>

    <target name="lint-errorprone" depends="build,lint-init" description="Compile the main sources with Error Prone">
        <delete dir="${lint.dir}/classes" />
        <mkdir dir="${lint.dir}/classes" />
        <pathconvert property="errorprone.path">
            <fileset dir="${lint.dir}/lib/errorprone" includes="*.jar" />
        </pathconvert>
        <pathconvert property="errorprone.classpath" refid="cassandra-stress.classpath" />
        <pathconvert property="errorprone.sources" pathsep="${line.separator}">
            <fileset dir="${build.src.java}" includes="**/*.java" />
        </pathconvert>
        <echo file="${lint.dir}/errorprone-sources.txt" message="${errorprone.sources}" />
        <exec executable="${java.home}/bin/javac" output="${lint.dir}/reports/errorprone.txt" resultproperty="errorprone.result">
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED" />
            <arg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED" />
            <arg value="-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
            <arg value="-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED" />
            <arg value="-XDcompilePolicy=simple" />
            <arg value="--should-stop=ifError=FLOW" />
            <arg value="-XDaddTypeAnnotationsToSymbol=true" />
            <arg value="--release" />
            <arg value="${release.version}" />
            <arg value="-encoding" />
            <arg value="utf-8" />
            <arg value="-proc:none" />
            <arg value="-Xmaxwarns" />
            <arg value="10000" />
            <arg value="-processorpath" />
            <arg value="${errorprone.path}" />
            <arg value="-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -Xep:JavaUtilDate:OFF -Xep:StringSplitter:OFF -Xep:ImmutableEnumChecker:OFF -Xep:AnnotateFormatMethod:OFF -Xep:ExposedPrivateType:OFF -Xep:EffectivelyPrivate:OFF" />
            <arg value="-cp" />
            <arg value="${errorprone.classpath}" />
            <arg value="-d" />
            <arg value="${lint.dir}/classes" />
            <arg value="@${lint.dir}/errorprone-sources.txt" />
        </exec>
        <loadfile property="errorprone.output" srcFile="${lint.dir}/reports/errorprone.txt" failonerror="false" />
        <echo message="${errorprone.output}" />
        <fail message="Error Prone reported findings.">
            <condition>
                <or>
                    <not>
                        <equals arg1="${errorprone.result}" arg2="0" />
                    </not>
                    <matches string="${errorprone.output}" pattern="(warning|error): \[[A-Za-z]+\]" multiline="true" />
                </or>
            </condition>
        </fail>
    </target>

    <target name="lint-checkstyle" depends="lint-init" description="Check the sources with Checkstyle">
        <taskdef resource="com/puppycrawl/tools/checkstyle/ant/checkstyle-ant-task.properties">
            <classpath>
                <fileset dir="${lint.dir}/lib/checkstyle" includes="*.jar" />
            </classpath>
        </taskdef>
        <checkstyle config="${lint.config}/checkstyle.xml" failOnViolation="true" maxWarnings="0">
            <fileset dir="${build.src.java}" includes="**/*.java" />
            <fileset dir="${test.unit.src}" includes="**/*.java" />
            <fileset dir="${test.integration.src}" includes="**/*.java" />
            <formatter type="plain" />
            <formatter type="xml" toFile="${lint.dir}/reports/checkstyle.xml" />
        </checkstyle>
    </target>

    <target name="lint-pmd" depends="lint-init" description="Check the sources with PMD">
        <taskdef name="pmd" classname="net.sourceforge.pmd.ant.PMDTask">
            <classpath>
                <fileset dir="${lint.dir}/lib/pmd" includes="*.jar" />
            </classpath>
        </taskdef>
        <pmd rulesetfiles="${lint.config}/pmd.xml" failOnRuleViolation="true" minimumPriority="5">
            <auxclasspath>
                <path refid="cassandra-stress.classpath" />
            </auxclasspath>
            <sourceLanguage name="java" version="21" />
            <fileset dir="${build.src.java}" includes="**/*.java" />
            <formatter type="text" toConsole="true" />
            <formatter type="xml" toFile="${lint.dir}/reports/pmd.xml" />
        </pmd>
    </target>

    <target name="lint-spotbugs" depends="build,lint-init" description="Check the compiled classes with SpotBugs">
        <taskdef name="spotbugs" classname="edu.umd.cs.findbugs.anttask.FindBugsTask">
            <classpath>
                <fileset dir="${lint.dir}/lib/spotbugs" includes="*.jar" />
            </classpath>
        </taskdef>
        <path id="spotbugs.classpath"><fileset dir="${lint.dir}/lib/spotbugs" includes="*.jar" /></path>
        <spotbugs classpathref="spotbugs.classpath" output="text" outputFile="${lint.dir}/reports/spotbugs.txt"
            effort="max" reportLevel="medium" excludeFilter="${lint.config}/spotbugs-exclude.xml"
            warningsProperty="spotbugs.warnings" errorProperty="spotbugs.error" jvmargs="-Xmx1024m" timeout="1200000">
            <auxClasspath>
                <path refid="cassandra-stress.classpath" />
            </auxClasspath>
            <sourcePath path="${build.src.java}" />
            <class location="${build.classes.main}" />
        </spotbugs>
        <concat><fileset file="${lint.dir}/reports/spotbugs.txt" /></concat>
        <fail message="SpotBugs failed to run." if="spotbugs.error" />
        <fail message="SpotBugs reported warnings." if="spotbugs.warnings" />
    </target>

    <target name="lint" depends="format-check,lint-errorprone,lint-checkstyle,lint-pmd,lint-spotbugs"
        description="Run Error Prone, Checkstyle, PMD and SpotBugs" />
    <macrodef name="palantir-format">
        <attribute name="mode" />
        <attribute name="result" />
        <sequential>
            <resolve-tool deps="format-deps" dir="${lint.dir}/lib/format" />
            <pathconvert property="format.sources" pathsep="${line.separator}">
                <fileset dir="${build.src.java}" includes="**/*.java" />
                <fileset dir="${test.unit.src}" includes="**/*.java" />
                <fileset dir="${test.integration.src}" includes="**/*.java" />
            </pathconvert>
            <mkdir dir="${lint.dir}" />
            <echo file="${lint.dir}/format-sources.txt" message="${format.sources}" />
            <java classname="com.palantir.javaformat.java.Main" fork="true" failonerror="false" resultproperty="@{result}">
                <classpath>
                    <fileset dir="${lint.dir}/lib/format" includes="*.jar" />
                </classpath>
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED" />
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED" />
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED" />
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED" />
                <jvmarg value="--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED" />
                <arg line="@{mode}" />
                <arg value="@${lint.dir}/format-sources.txt" />
            </java>
        </sequential>
    </macrodef>

    <target name="format" depends="resolver-init" description="Format the Java sources with palantir-java-format">
        <palantir-format mode="--palantir --replace" result="format.result" />
        <fail message="palantir-java-format failed.">
            <condition>
                <not>
                    <equals arg1="${format.result}" arg2="0" />
                </not>
            </condition>
        </fail>
    </target>

    <target name="format-check" depends="resolver-init" description="Fail when a Java source is not formatted">
        <palantir-format mode="--palantir --dry-run --set-exit-if-changed" result="format.result" />
        <fail message="Some files are not formatted. Run ant format.">
            <condition>
                <not>
                    <equals arg1="${format.result}" arg2="0" />
                </not>
            </condition>
        </fail>
    </target>
</project>
