set -o pipefail

DESC="Cassandra Stress"
PACKAGE_HOME="/usr/share/cassandra-stress"
MIN_JAVA_VERSION=21

has_jars() {
  [ -n "$(find "$1" -maxdepth 1 -name '*.jar' -print -quit 2>/dev/null)" ]
}

# Prints the storage directory of the user in TMPDIR. Another user can create
# that path first, so it must be a real directory that only this user can use.
private_tmp_dir() {
  local dir
  dir="${TMPDIR:-/tmp}/cassandra-stress-$(id -u)"
  mkdir -m 700 "$dir" 2>/dev/null
  if [ -L "$dir" ] || [ ! -d "$dir" ] || [ ! -O "$dir" ] || ! chmod 700 "$dir" 2>/dev/null; then
    echo "Error: $dir is not a directory that only $(id -un) owns. Set CASSANDRA_STRESS_STORAGE_DIR to choose another directory." >&2
    return 1
  fi
  echo "$dir"
}

# Prints the version of the java binary $1, such as 21.0.9. The release file
# of the JDK holds the version, so a JVM starts only when that file is missing.
java_version() {
  local home version=""
  home="$(dirname "$(dirname "$(realpath "$1")")")"
  if [ -r "$home/release" ]; then
    version=$(awk -F'"' '/^JAVA_VERSION=/ { print $2 }' "$home/release")
  fi
  if [ -z "$version" ]; then
    version=$("$1" -XshowSettings:properties -version 2>&1 | awk '/^ *java.version = / { print $3 }')
  fi
  echo "${version#1.}"
}

# Prints the major version of the java binary $1.
java_major_version() {
  local version
  version="$(java_version "$1")"
  echo "${version%%[!0-9]*}"
}

# Compares the first $3 parts of the dotted versions $1 and $2, and prints
# -1, 0 or 1. A missing part is 0, and a part ends at its first non-digit.
compare_versions() {
  local i a b
  local -a left right
  IFS=. read -r -a left <<< "$1"
  IFS=. read -r -a right <<< "$2"
  for ((i = 0; i < $3; i++)); do
    a="${left[i]:-0}"
    b="${right[i]:-0}"
    a="${a%%[!0-9]*}"
    b="${b%%[!0-9]*}"
    if [ "${a:-0}" -lt "${b:-0}" ]; then
      echo -1
      return
    elif [ "${a:-0}" -gt "${b:-0}" ]; then
      echo 1
      return
    fi
  done
  echo 0
}

# Succeeds when the version $1 is in the range $2, "<min>-<max>" or "<min>-".
# The bounds are dotted versions, and a short bound covers its updates, so
# 21.0.9-21 holds 21.0.9 and every later update of 21.
version_in_range() {
  local min="${2%%-*}" max="${2#*-}" parts
  [ "$(compare_versions "$1" "$min" 4)" -ge 0 ] || return 1
  [ -z "$max" ] && return 0
  parts="${max//[!.]/}"
  [ "$(compare_versions "$1" "$max" $((${#parts} + 1)))" -le 0 ]
}

# Sets JAVA and JAVA_MAJOR. JAVA_HOME wins. Otherwise use java from PATH, and
# when it is too old, the newest supported runtime in /usr/lib/jvm, where the
# system packages put it.
find_java() {
  local candidate major

  if [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
    [ -x "$JAVA" ] && JAVA_MAJOR=$(java_major_version "$JAVA")
    return
  fi

  JAVA="$(command -v java)"
  if [ -n "$JAVA" ]; then
    JAVA_MAJOR=$(java_major_version "$JAVA")
    if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge "$MIN_JAVA_VERSION" ]; then
      return
    fi
  fi

  for candidate in /usr/lib/jvm/*/bin/java; do
    [ -x "$candidate" ] || continue
    major=$(java_major_version "$candidate")
    if [ -n "$major" ] && [ "$major" -ge "$MIN_JAVA_VERSION" ] && [ "$major" -gt "${JAVA_MAJOR:-0}" ]; then
      JAVA="$candidate"
      JAVA_MAJOR="$major"
    fi
  done
}

# Appends to DEFAULT_JVM_OPTS the options of the file $1 that apply to Java
# $JAVA_RUNTIME_VERSION. A line "<min>-<max>:<option>" or "<min>-:<option>"
# applies to those versions only. When $2 is "skip-collector", the lines that
# select a collector do not apply.
read_jvm_options() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      -*) ;;
      [0-9]*-*:-*)
        version_in_range "$JAVA_RUNTIME_VERSION" "${line%%:*}" || continue
        line="${line#*:}"
      ;;
      *) continue ;;
    esac
    if [ "${2:-}" = skip-collector ] && [[ "$line" =~ ^-XX:\+Use[A-Za-z0-9]+GC$ ]]; then
      continue
    fi
    DEFAULT_JVM_OPTS+=("$line")
  done < "$1"
}

case "$1" in
  usage)
    echo "Cassandra-Stress Server Usage: $0 start|stop|status [-h <host>]"
    echo "Cassandra-Stress Usage: $0 [options]"
    exit 1
  ;;
  stop)
    PID="$(cat ./stressd.pid 2> /dev/null)"
    if [ -z "$PID" ]; then
      echo "$DESC is not running."
    else
      kill -9 "$PID"
      rm ./stressd.pid
      echo "$DESC is stopped."
    fi
    exit 0
  ;;
  status)
    PID="$(cat ./stressd.pid 2> /dev/null)"
    if [ -z "$PID" ]; then
      echo "$DESC is not running."
    else
      echo "$DESC is running with pid $PID."
    fi
    exit 0
  ;;
esac

find_java

if [ ! -x "$JAVA" ]; then
  echo "Unable to find the java executable. Check the JAVA_HOME and PATH environment variables." >&2
  exit 1
fi

if [ -z "$JAVA_MAJOR" ] || [ "$JAVA_MAJOR" -lt "$MIN_JAVA_VERSION" ]; then
  echo "Cassandra-Stress requires Java $MIN_JAVA_VERSION or newer. $JAVA is Java ${JAVA_MAJOR:-of an unknown version}." >&2
  exit 1
fi

JAVA_RUNTIME_VERSION="$(java_version "$JAVA")"

# The home is the parent of the real bin directory. A package links
# /usr/bin/cassandra-stress to $PACKAGE_HOME/bin/cassandra-stress.
if [ -z "$CASSANDRA_STRESS_HOME" ]; then
  CASSANDRA_STRESS_HOME="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
fi

if [ -z "$CASSANDRA_STRESS_CONFIG" ]; then
  CASSANDRA_STRESS_CONFIG="$CASSANDRA_STRESS_HOME/conf"
fi

if [ ! -d "$CASSANDRA_STRESS_CONFIG" ]; then
  echo "Error: the configuration directory $CASSANDRA_STRESS_CONFIG does not exist." >&2
  exit 1
fi

# A package installs into a read-only directory, so it keeps the logs in the
# state directory of the user. Without HOME, as under some service managers,
# the logs go to a directory of the user in TMPDIR.
if [ -z "$CASSANDRA_STRESS_STORAGE_DIR" ]; then
  if [ "$CASSANDRA_STRESS_HOME" != "$PACKAGE_HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$CASSANDRA_STRESS_HOME/data"
  elif [ -n "$XDG_STATE_HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$XDG_STATE_HOME/cassandra-stress"
  elif [ -n "$HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$HOME/.local/state/cassandra-stress"
  else
    CASSANDRA_STRESS_STORAGE_DIR="$(private_tmp_dir)" || exit 1
  fi
fi

# A home that the user cannot write, such as a Docker image run with --user or
# a tarball that root unpacked, keeps the logs in a directory of the user in TMPDIR.
LOG_DIR="$CASSANDRA_STRESS_STORAGE_DIR/logs"
if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
  FALLBACK_STORAGE_DIR="$(private_tmp_dir)" || exit 1
  echo "Warning: cannot create $LOG_DIR. The logs go to $FALLBACK_STORAGE_DIR/logs. Set CASSANDRA_STRESS_STORAGE_DIR to choose another directory." >&2
  CASSANDRA_STRESS_STORAGE_DIR="$FALLBACK_STORAGE_DIR"
  LOG_DIR="$CASSANDRA_STRESS_STORAGE_DIR/logs"
  mkdir -p "$LOG_DIR" 2>/dev/null
fi

# Every jar in lib is a module. A source checkout runs the tree that
# ./gradlew installDist writes.
MODULE_PATH="$CASSANDRA_STRESS_HOME/lib"
if ! has_jars "$MODULE_PATH"; then
  MODULE_PATH="$CASSANDRA_STRESS_HOME/build/install/cassandra-stress/lib"
fi

if ! has_jars "$MODULE_PATH"; then
  echo "Found no jar files in $CASSANDRA_STRESS_HOME/lib. Run ./gradlew installDist in a source checkout." >&2
  exit 1
fi

MAIN_MODULE="org.apache.cassandra.stress"

# JVM_OPTS comes after the default options, so an option in it wins. The JVM
# stops when two options select a collector, so a collector in JVM_OPTS,
# JAVA_TOOL_OPTIONS or JDK_JAVA_OPTIONS replaces the default collector. The
# other options of jvm-gc.options, such as -XX:+ZGenerational, still apply.
DEFAULT_JVM_OPTS=()
JVM_OPTS="${JVM_OPTS:-}"
GC_MODE=""
if [[ " $JVM_OPTS ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} " =~ [[:space:]]-XX:\+Use[A-Za-z0-9]+GC[[:space:]] ]]; then
  GC_MODE=skip-collector
fi
# The build writes the JVM options into conf. Each file comes from
# CASSANDRA_STRESS_CONFIG when it is there, and otherwise from the conf
# directory next to lib, as in a source checkout after ./gradlew installDist.
for file in jvm-clients.options jvm-gc.options; do
  mode=""
  [ "$file" = jvm-gc.options ] && mode="$GC_MODE"
  options_file="$CASSANDRA_STRESS_CONFIG/$file"
  [ -r "$options_file" ] || options_file="$(dirname "$MODULE_PATH")/conf/$file"
  if [ -r "$options_file" ]; then
    read_jvm_options "$options_file" "$mode"
  else
    echo "Warning: cannot read $file in $CASSANDRA_STRESS_CONFIG or $(dirname "$MODULE_PATH")/conf. Stress runs without its JVM options." >&2
  fi
done

case "$1" in
  start)
    echo "Starting $DESC: "
    # shellcheck disable=SC2086
    "$JAVA" "${DEFAULT_JVM_OPTS[@]}" $JVM_OPTS \
      -server \
      --module-path "$MODULE_PATH" \
      --add-modules ALL-MODULE-PATH \
      -Dcassandra.storagedir="$CASSANDRA_STRESS_STORAGE_DIR" \
      -Dcassandra.logdir="$LOG_DIR" \
      -Dlogback.configurationFile="$CASSANDRA_STRESS_CONFIG/logback.xml" \
      -m "$MAIN_MODULE/org.apache.cassandra.stress.StressServer" \
      "$@" 1> "$LOG_DIR/stressd.out.log" 2> "$LOG_DIR/stressd.err.log" &
    echo $! > ./stressd.pid
    echo "done."
  ;;

  *)
    # shellcheck disable=SC2086
    exec "$JAVA" "${DEFAULT_JVM_OPTS[@]}" $JVM_OPTS \
      --module-path "$MODULE_PATH" \
      --add-modules ALL-MODULE-PATH \
      -Dcassandra.storagedir="$CASSANDRA_STRESS_STORAGE_DIR" \
      -Dcassandra.logdir="$LOG_DIR" \
      -Dlogback.configurationFile="$CASSANDRA_STRESS_CONFIG/logback.xml" \
      -m "$MAIN_MODULE/org.apache.cassandra.stress.Stress" "$@"
  ;;
esac
