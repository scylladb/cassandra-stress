set -o pipefail

DESC="Cassandra Stress"
PACKAGE_HOME="/usr/share/cassandra-stress"
MIN_JAVA_VERSION=21

has_jars() {
  [ -n "$(find "$1" -maxdepth 1 -name '*.jar' -print -quit 2>/dev/null)" ]
}

# Prints the storage directory of the user in TMPDIR. Another user can create
# that path first, so it must be a real directory that only this user can use.
private_tmp_dir() {
  local dir
  dir="${TMPDIR:-/tmp}/cassandra-stress-$(id -u)"
  mkdir -m 700 "$dir" 2>/dev/null
  if [ -L "$dir" ] || [ ! -d "$dir" ] || [ ! -O "$dir" ] || ! chmod 700 "$dir" 2>/dev/null; then
    echo "Error: $dir is not a directory that only $(id -un) owns. Set CASSANDRA_STRESS_STORAGE_DIR to choose another directory." >&2
    return 1
  fi
  echo "$dir"
}

# Prints the version of the java binary $1, such as 21.0.9. The release file
# of the JDK holds the version, so a JVM starts only when that file is missing.
java_version() {
  local home version=""
  home="$(dirname "$(dirname "$(realpath "$1")")")"
  if [ -r "$home/release" ]; then
    version=$(awk -F'"' '/^JAVA_VERSION=/ { print $2 }' "$home/release")
  fi
  if [ -z "$version" ]; then
    version=$("$1" -XshowSettings:properties -version 2>&1 | awk '/^ *java.version = / { print $3 }')
  fi
  echo "${version#1.}"
}

# Prints the major version of the java binary $1.
java_major_version() {
  local version
  version="$(java_version "$1")"
  echo "${version%%[!0-9]*}"
}

# Compares the first $3 parts of the dotted versions $1 and $2, and prints
# -1, 0 or 1. A missing part is 0, and a part ends at its first non-digit.
compare_versions() {
  local i a b
  local -a left right
  IFS=. read -r -a left <<< "$1"
  IFS=. read -r -a right <<< "$2"
  for ((i = 0; i < $3; i++)); do
    a="${left[i]:-0}"
    b="${right[i]:-0}"
    a="${a%%[!0-9]*}"
    b="${b%%[!0-9]*}"
    if [ "${a:-0}" -lt "${b:-0}" ]; then
      echo -1
      return
    elif [ "${a:-0}" -gt "${b:-0}" ]; then
      echo 1
      return
    fi
  done
  echo 0
}

# Succeeds when the version $1 is in the range $2, "<min>-<max>" or "<min>-".
# The bounds are dotted versions, and a short bound covers its updates, so
# 21.0.9-21 holds 21.0.9 and every later update of 21.
version_in_range() {
  local min="${2%%-*}" max="${2#*-}" parts
  [ "$(compare_versions "$1" "$min" 4)" -ge 0 ] || return 1
  [ -z "$max" ] && return 0
  parts="${max//[!.]/}"
  [ "$(compare_versions "$1" "$max" $((${#parts} + 1)))" -le 0 ]
}

# Sets JAVA and JAVA_MAJOR. JAVA_HOME wins. Otherwise use java from PATH, and
# when it is too old, the newest supported runtime in /usr/lib/jvm, where the
# system packages put it.
find_java() {
  local candidate major

  if [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
    [ -x "$JAVA" ] && JAVA_MAJOR=$(java_major_version "$JAVA")
    return
  fi

  JAVA="$(command -v java)"
  if [ -n "$JAVA" ]; then
    JAVA_MAJOR=$(java_major_version "$JAVA")
    if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge "$MIN_JAVA_VERSION" ]; then
      return
    fi
  fi

  for candidate in /usr/lib/jvm/*/bin/java; do
    [ -x "$candidate" ] || continue
    major=$(java_major_version "$candidate")
    if [ -n "$major" ] && [ "$major" -ge "$MIN_JAVA_VERSION" ] && [ "$major" -gt "${JAVA_MAJOR:-0}" ]; then
      JAVA="$candidate"
      JAVA_MAJOR="$major"
    fi
  done
}

# Appends to DEFAULT_JVM_OPTS the options of the file $1 that apply to Java
# $JAVA_RUNTIME_VERSION. A line "<min>-<max>:<option>" or "<min>-:<option>"
# applies to those versions only. When $2 is "skip-collector", the lines that
# select a collector do not apply.
read_jvm_options() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      -*) ;;
      [0-9]*-*:-*)
        version_in_range "$JAVA_RUNTIME_VERSION" "${line%%:*}" || continue
        line="${line#*:}"
      ;;
      *) continue ;;
    esac
    if [ "${2:-}" = skip-collector ] && [[ "$line" =~ ^-XX:\+Use[A-Za-z0-9]+GC$ ]]; then
      continue
    fi
    DEFAULT_JVM_OPTS+=("$line")
  done < "$1"
}

# Prints the directory of the cgroup at the path $2 below the mount $1, then
# the directory of each parent up to $1. A container with its own cgroup
# namespace on cgroup v1 mounts its cgroup at $1, so its path in
# /proc/self/cgroup is not below the mount.
cgroup_dirs() {
  local root="$1" dir="$1/${2#/}"
  dir="${dir%/}"
  if [ ! -d "$dir" ] || [[ "$dir" == *..* ]]; then
    dir="$root"
  fi
  while :; do
    echo "$dir"
    [ "$dir" = "$root" ] && break
    dir="${dir%/*}"
  done
}

# Prints "<limit> <usage> <page cache>" in bytes for each directory of
# cgroup_dirs $1 $2 with a memory limit in the file $3. $4 is the usage file,
# and $5 the field of memory.stat with the page cache that the kernel can drop.
cgroup_limits_below() {
  local dir limit
  while read -r dir; do
    limit=$(cat "$dir/$3" 2>/dev/null)
    if [[ "$limit" =~ ^[0-9]+$ ]]; then
      echo "$limit $(cat "$dir/$4" 2>/dev/null) $(awk -v field="$5" '$1 == field { print $2 }' "$dir/memory.stat" 2>/dev/null)"
    fi
  done < <(cgroup_dirs "$1" "$2")
}

# Prints the memory limits of the cgroup of this process and of its parents,
# one line for each, as cgroup_limits_below prints them. A parent can have a
# lower limit than the cgroup of the process. Uses cgroup v2 when it controls
# the memory, and otherwise the memory hierarchy of cgroup v1.
cgroup_memory_limits() {
  local v2 v1 limits=""
  v2=$(awk -F: '$1 == "0" && $2 == "" { print $3; exit }' /proc/self/cgroup 2>/dev/null)
  v1=$(awk -F: '$2 ~ /(^|,)memory(,|$)/ { print $3; exit }' /proc/self/cgroup 2>/dev/null)
  if [ -n "$v2" ]; then
    limits=$(cgroup_limits_below /sys/fs/cgroup "$v2" memory.max memory.current inactive_file)
  fi
  if [ -z "$limits" ] && [ -n "$v1" ]; then
    limits=$(cgroup_limits_below /sys/fs/cgroup/memory "$v1" memory.limit_in_bytes memory.usage_in_bytes total_inactive_file)
  fi
  [ -n "$limits" ] && echo "$limits"
}

# Prints the memory in MiB that a new process can take. That is the available
# memory of the machine, or less when a cgroup of this process has a lower
# limit. The page cache that the kernel can drop counts as available. Prints
# nothing when the system does not show its memory, as on macOS.
available_memory_mib() {
  local available limit usage inactive free
  available=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)
  [ -n "$available" ] || return 0
  while read -r limit usage inactive; do
    [[ "$usage" =~ ^[0-9]+$ ]] || continue
    free=$(( (limit - usage + ${inactive:-0}) / 1048576 ))
    [ "$free" -lt 0 ] && free=0
    [ "$free" -lt "$available" ] && available=$free
  done < <(cgroup_memory_limits)
  echo "$available"
}

# Prints the memory in MiB of the machine, or the lowest memory limit of the
# cgroups of this process when it is lower. Prints nothing when the system
# does not show its memory.
memory_limit_mib() {
  local total limit rest
  total=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)
  [ -n "$total" ] || return 0
  while read -r limit rest; do
    [ $(( limit / 1048576 )) -lt "$total" ] && total=$(( limit / 1048576 ))
  done < <(cgroup_memory_limits)
  echo "$total"
}

# Prints the number of CPUs that this process can use: the CPUs that it may
# run on, or fewer when the cgroup of the process or a parent has a lower CPU
# quota. A quota of 1.5 CPUs counts as 2. Prints nothing when nproc is missing.
cpu_count() {
  local cpus path dir quota period
  cpus=$(nproc 2>/dev/null) || return 0
  path=$(awk -F: '$1 == "0" && $2 == "" { print $3; exit }' /proc/self/cgroup 2>/dev/null)
  if [ -n "$path" ]; then
    while read -r dir; do
      read -r quota period 2>/dev/null < "$dir/cpu.max" || continue
      if [[ "$quota" =~ ^[0-9]+$ ]] && [[ "$period" =~ ^[1-9][0-9]*$ ]]; then
        quota=$(( (quota + period - 1) / period ))
        [ "$quota" -lt "$cpus" ] && cpus=$quota
      fi
    done < <(cgroup_dirs /sys/fs/cgroup "$path")
  fi
  path=$(awk -F: '$2 ~ /(^|,)cpu(,|$)/ { print $3; exit }' /proc/self/cgroup 2>/dev/null)
  if [ -n "$path" ] && [ -d /sys/fs/cgroup/cpu ]; then
    while read -r dir; do
      quota=$(cat "$dir/cpu.cfs_quota_us" 2>/dev/null)
      period=$(cat "$dir/cpu.cfs_period_us" 2>/dev/null)
      if [[ "$quota" =~ ^[0-9]+$ ]] && [[ "$period" =~ ^[1-9][0-9]*$ ]]; then
        quota=$(( (quota + period - 1) / period ))
        [ "$quota" -lt "$cpus" ] && cpus=$quota
      fi
    done < <(cgroup_dirs "$(realpath /sys/fs/cgroup/cpu)" "$path")
  fi
  echo "$cpus"
}

case "$1" in
  usage)
    echo "Cassandra-Stress Server Usage: $0 start|stop|status [-h <host>]"
    echo "Cassandra-Stress Usage: $0 [options]"
    exit 1
  ;;
  stop)
    PID="$(cat ./stressd.pid 2> /dev/null)"
    if [ -z "$PID" ]; then
      echo "$DESC is not running."
    else
      kill -9 "$PID"
      rm ./stressd.pid
      echo "$DESC is stopped."
    fi
    exit 0
  ;;
  status)
    PID="$(cat ./stressd.pid 2> /dev/null)"
    if [ -z "$PID" ]; then
      echo "$DESC is not running."
    else
      echo "$DESC is running with pid $PID."
    fi
    exit 0
  ;;
esac

find_java

if [ ! -x "$JAVA" ]; then
  echo "Unable to find the java executable. Check the JAVA_HOME and PATH environment variables." >&2
  exit 1
fi

if [ -z "$JAVA_MAJOR" ] || [ "$JAVA_MAJOR" -lt "$MIN_JAVA_VERSION" ]; then
  echo "Cassandra-Stress requires Java $MIN_JAVA_VERSION or newer. $JAVA is Java ${JAVA_MAJOR:-of an unknown version}." >&2
  exit 1
fi

JAVA_RUNTIME_VERSION="$(java_version "$JAVA")"

# The home is the parent of the real bin directory. A package links
# /usr/bin/cassandra-stress to $PACKAGE_HOME/bin/cassandra-stress.
if [ -z "$CASSANDRA_STRESS_HOME" ]; then
  CASSANDRA_STRESS_HOME="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
fi

if [ -z "$CASSANDRA_STRESS_CONFIG" ]; then
  CASSANDRA_STRESS_CONFIG="$CASSANDRA_STRESS_HOME/conf"
fi

if [ ! -d "$CASSANDRA_STRESS_CONFIG" ]; then
  echo "Error: the configuration directory $CASSANDRA_STRESS_CONFIG does not exist." >&2
  exit 1
fi

# A package installs into a read-only directory, so it keeps the logs in the
# state directory of the user. Without HOME, as under some service managers,
# the logs go to a directory of the user in TMPDIR.
if [ -z "$CASSANDRA_STRESS_STORAGE_DIR" ]; then
  if [ "$CASSANDRA_STRESS_HOME" != "$PACKAGE_HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$CASSANDRA_STRESS_HOME/data"
  elif [ -n "$XDG_STATE_HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$XDG_STATE_HOME/cassandra-stress"
  elif [ -n "$HOME" ]; then
    CASSANDRA_STRESS_STORAGE_DIR="$HOME/.local/state/cassandra-stress"
  else
    CASSANDRA_STRESS_STORAGE_DIR="$(private_tmp_dir)" || exit 1
  fi
fi

# A home that the user cannot write, such as a Docker image run with --user or
# a tarball that root unpacked, keeps the logs in a directory of the user in TMPDIR.
LOG_DIR="$CASSANDRA_STRESS_STORAGE_DIR/logs"
if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
  FALLBACK_STORAGE_DIR="$(private_tmp_dir)" || exit 1
  echo "Warning: cannot create $LOG_DIR. The logs go to $FALLBACK_STORAGE_DIR/logs. Set CASSANDRA_STRESS_STORAGE_DIR to choose another directory." >&2
  CASSANDRA_STRESS_STORAGE_DIR="$FALLBACK_STORAGE_DIR"
  LOG_DIR="$CASSANDRA_STRESS_STORAGE_DIR/logs"
  mkdir -p "$LOG_DIR" 2>/dev/null
fi

# Every jar in lib is a module. A source checkout runs the tree that
# ./gradlew installDist writes.
MODULE_PATH="$CASSANDRA_STRESS_HOME/lib"
if ! has_jars "$MODULE_PATH"; then
  MODULE_PATH="$CASSANDRA_STRESS_HOME/build/install/cassandra-stress/lib"
fi

if ! has_jars "$MODULE_PATH"; then
  echo "Found no jar files in $CASSANDRA_STRESS_HOME/lib. Run ./gradlew installDist in a source checkout." >&2
  exit 1
fi

MAIN_MODULE="org.apache.cassandra.stress"

# JVM_OPTS comes after the default options, so an option in it wins. The JVM
# stops when two options select a collector, so a collector in JVM_OPTS,
# JAVA_TOOL_OPTIONS or JDK_JAVA_OPTIONS replaces the default collector. The
# other options of jvm-gc.options, such as -XX:+ZGenerational, still apply.
DEFAULT_JVM_OPTS=()
JVM_OPTS="${JVM_OPTS:-}"
GC_MODE=""
if [[ " $JVM_OPTS ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} " =~ [[:space:]]-XX:\+Use[A-Za-z0-9]+GC[[:space:]] ]]; then
  GC_MODE=skip-collector
fi
# With less than 4 CPUs or 4 GiB of memory or less, stress runs on G1,
# unless the user selects a collector. With 700 threads on 1 or 2 CPUs, ZGC
# wrote 15% to 41% fewer operations per second than G1. Up to 4 GiB of
# memory, ZGC filled 95% to 100% of the memory of the container, and below
# 2 GiB it stalled the stress threads.
if [ -z "$GC_MODE" ]; then
  memory="$(memory_limit_mib)"
  cpus="$(cpu_count)"
  if [ -n "$memory" ] && { [ "$memory" -le 4096 ] || [ "${cpus:-4}" -lt 4 ]; }; then
    GC_MODE=skip-collector
    DEFAULT_JVM_OPTS+=("-XX:+UseG1GC")
  fi
fi
# The build writes the JVM options into conf. Each file comes from
# CASSANDRA_STRESS_CONFIG when it is there, and otherwise from the conf
# directory next to lib, as in a source checkout after ./gradlew installDist.
for file in jvm-clients.options jvm-gc.options; do
  mode=""
  [ "$file" = jvm-gc.options ] && mode="$GC_MODE"
  options_file="$CASSANDRA_STRESS_CONFIG/$file"
  [ -r "$options_file" ] || options_file="$(dirname "$MODULE_PATH")/conf/$file"
  if [ -r "$options_file" ]; then
    read_jvm_options "$options_file" "$mode"
  else
    echo "Warning: cannot read $file in $CASSANDRA_STRESS_CONFIG or $(dirname "$MODULE_PATH")/conf. Stress runs without its JVM options." >&2
  fi
done

# The heap balancer in each stress process shares the memory of the machine
# with the other stress processes. A heap option in JVM_OPTS,
# JAVA_TOOL_OPTIONS, JDK_JAVA_OPTIONS or the options files keeps the heap of
# the user, and the balancer then only reports this heap to the other
# processes. The options files of the build set the heap with
# MaxRAMPercentage and MinRAMPercentage only.
#
# On ZGC, the heap starts at 64 MiB and can grow to 85% of the memory, and the
# balancer sets the soft maximum heap.
#
# On G1 and Linux, a workload or the stress server takes a fixed heap when it
# starts. -Xms is equal to -Xmx, and -XX:+AlwaysPreTouch touches every page, so
# a later process sees this memory as used. The heap is 1/2 of the free memory.
# Above 1 GiB of free memory, it is 1/2 of the free memory less 256 MiB, and
# 512 MiB or more. It is at most 31 GiB, so the JVM keeps compressed object
# pointers. The free memory is the available memory of the machine, or of a
# cgroup of the process when its limit is lower. The help, print and version
# commands keep the default heap of the JVM.
collector_opts=" ${DEFAULT_JVM_OPTS[*]} $JVM_OPTS ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} "
if [[ " $JVM_OPTS ${JAVA_TOOL_OPTIONS:-} ${JDK_JAVA_OPTIONS:-} " =~ [[:space:]](-Xm[sx]|-XX:(MaxHeapSize|InitialHeapSize|MaxRAM|MaxRAMPercentage|InitialRAMPercentage|SoftMaxHeapSize)=) ]] \
  || [[ " ${DEFAULT_JVM_OPTS[*]} " =~ [[:space:]](-Xm[sx]|-XX:(MaxHeapSize|InitialHeapSize|SoftMaxHeapSize)=) ]]; then
  DEFAULT_JVM_OPTS+=("-Dcassandra.stress.heap.balance=false")
elif [[ "$collector_opts" == *" -XX:+UseZGC "* ]]; then
  DEFAULT_JVM_OPTS+=("-Xms64m")
else
  case "$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    ""|help|-\?|print|version) ;;
    *)
      available="$(available_memory_mib)"
      if [ -n "$available" ]; then
        heap=$(( available / 2 ))
        if [ "$available" -ge 1024 ]; then
          heap=$(( available / 2 - 256 ))
          [ "$heap" -lt 512 ] && heap=512
        fi
        [ "$heap" -gt 31744 ] && heap=31744
        if [ "$heap" -lt 64 ]; then
          echo "Error: $available MiB of memory is free. Stress needs a heap of 64 MiB or more. Set -Xmx in JVM_OPTS to start anyway." >&2
          exit 1
        fi
        DEFAULT_JVM_OPTS+=("-Xms${heap}m" "-Xmx${heap}m")
      fi
    ;;
  esac
fi

case "$1" in
  start)
    echo "Starting $DESC: "
    # shellcheck disable=SC2086
    "$JAVA" "${DEFAULT_JVM_OPTS[@]}" $JVM_OPTS \
      -server \
      --module-path "$MODULE_PATH" \
      --add-modules ALL-MODULE-PATH \
      -Dcassandra.storagedir="$CASSANDRA_STRESS_STORAGE_DIR" \
      -Dcassandra.logdir="$LOG_DIR" \
      -Dlogback.configurationFile="$CASSANDRA_STRESS_CONFIG/logback.xml" \
      -m "$MAIN_MODULE/org.apache.cassandra.stress.StressServer" \
      "$@" 1> "$LOG_DIR/stressd.out.log" 2> "$LOG_DIR/stressd.err.log" &
    echo $! > ./stressd.pid
    echo "done."
  ;;

  *)
    # shellcheck disable=SC2086
    exec "$JAVA" "${DEFAULT_JVM_OPTS[@]}" $JVM_OPTS \
      --module-path "$MODULE_PATH" \
      --add-modules ALL-MODULE-PATH \
      -Dcassandra.storagedir="$CASSANDRA_STRESS_STORAGE_DIR" \
      -Dcassandra.logdir="$LOG_DIR" \
      -Dlogback.configurationFile="$CASSANDRA_STRESS_CONFIG/logback.xml" \
      -m "$MAIN_MODULE/org.apache.cassandra.stress.Stress" "$@"
  ;;
esac
